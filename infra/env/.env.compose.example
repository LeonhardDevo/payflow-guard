# Variables interpolated by docker-compose.prod.yml (passed with --env-file infra/env/.env.compose).
# `npm run env:sync -- --prod` copies this file to infra/env/.env.compose and generates the password once.

# Compose project name of the production stack (containers, volumes, network).
COMPOSE_PROJECT=
# Postgres superuser of the stack; DATABASE_URL / DB_* of every service are built from these.
POSTGRES_USER=app
# URL-safe (hex) so it can be embedded in connection URLs. Generated; never commit the real value.
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host interface + ports the stack publishes. Put a TLS reverse proxy in front for real deployments:
#   /webhooks/* → worker, everything else → web.
PUBLISH_HOST=127.0.0.1
WEB_PUBLIC_PORT=8080
WORKER_PUBLIC_PORT=8081
