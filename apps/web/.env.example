# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
# Product display name (used in UI, emails, page titles). Per-project value.
APP_NAME="PayFlow Guard"
# local | testing | staging | production
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Public base URL of the web app (port 8100 for PayFlow Guard, see PLATFORM.md §2)
APP_URL=http://localhost:8100
# Port used by `php artisan serve` / `composer dev`
SERVER_PORT=8100
# All timestamps are stored and processed in UTC; users see their workspace timezone.
APP_TIMEZONE=UTC

# Default + fallback locale, and the comma-separated list of supported locales.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=en,ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────────────────────
# Product (config/product.php) — the only place the brand lives on the backend
# ─────────────────────────────────────────────────────────────────────────────
PRODUCT_SLUG=payflow
PRODUCT_TAGLINE="Invoices, approvals and payments under calm control"
# Telegram bot username without "@"; empty → Telegram linking shows as unavailable.
TELEGRAM_BOT_USERNAME=payflow_guard_bot
# Brand colors used in HTML emails (email clients do not support OKLCH tokens).
PRODUCT_EMAIL_PRIMARY="#059669"
PRODUCT_EMAIL_INK="#0B1324"
PRODUCT_EMAIL_ACCENT="#7C3AED"

# ─────────────────────────────────────────────────────────────────────────────
# Internal services (PLATFORM.md §4.1). The secret MUST be identical in the web and
# worker .env files: leave it empty here, `npm run setup` (scripts/env-sync.ts)
# writes one shared value into both. While empty (non-production only) every
# service uses the same built-in development secret. AI_URL is the RAG API of the
# worker (same process on 8101 in development; the `rag` role on 8102 in production).
# ─────────────────────────────────────────────────────────────────────────────
WORKER_URL=http://127.0.0.1:8101
AI_URL=http://127.0.0.1:8101
INTERNAL_API_SECRET=
# Per-pair keys (ADR-0010): web <-> worker and web <-> the worker RAG API (service `ai`). Written by `npm run setup`;
# required in production (32+ chars, distinct). Empty outside production = INTERNAL_API_SECRET.
INTERNAL_KEY_WEB_WORKER=
INTERNAL_KEY_WEB_AI=
# Max clock skew accepted for signed internal requests (seconds)
INTERNAL_API_TOLERANCE=300
# Timeout (seconds) for outgoing internal HTTP calls (assistant chat can be slow)
INTERNAL_HTTP_TIMEOUT=30

# ─────────────────────────────────────────────────────────────────────────────
# Logging. Production: LOG_STACK=json (structured JSON to stderr).
# ─────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Queries slower than this (ms) are logged as warnings (0 disables)
LOG_SLOW_QUERY_MS=500

# ─────────────────────────────────────────────────────────────────────────────
# Database — docker compose pgvector on 5441 (never the native 5432)
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5441
DB_DATABASE=payflow
DB_USERNAME=app
DB_PASSWORD=app
DB_SCHEMA=public

# ─────────────────────────────────────────────────────────────────────────────
# Redis 7 — docker compose on 6391 (never the native Redis 3 on 6379)
# Used for cache, sessions and rate limits.
# ─────────────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6391
REDIS_PREFIX=payflow-

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=payflow_session

CACHE_STORE=redis
CACHE_PREFIX=payflow-cache-

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Private disk for knowledge-base documents
DOCUMENTS_DISK=documents
QUEUE_CONNECTION=database

# ─────────────────────────────────────────────────────────────────────────────
# Mail. MAIL_MAILER=outbox renders every email in Laravel and hands it to the
# worker through the transactional outbox (topic email.send). The worker
# delivers via SMTP (Mailpit on 1031 / UI 8131 in dev).
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=outbox
# Only used when MAIL_MAILER=smtp (direct delivery, e.g. debugging): Mailpit.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1031
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@payflow.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# Billing. fake (default) works offline; market picks Stripe or YooKassa per workspace market; stripe/yookassa force one gateway.
# STRIPE_WEBHOOK_SECRET must equal the worker's value (fake checkout signs with it);
# empty = shared by setup (non-production fallback: whsec_test_local, the worker default).
# ─────────────────────────────────────────────────────────────────────────────
BILLING_DRIVER=fake
# Production refuses to boot with the fake driver unless a demo deploy opts in here.
BILLING_ALLOW_FAKE_IN_PRODUCTION=false
BILLING_CURRENCY=USD
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Stripe catalog: php artisan billing:sync-stripe creates Products/Prices by lookup_key <catalog>_<plan>_<interval>_<currency>
STRIPE_CATALOG=
STRIPE_API_BASE=
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_ID_COLLECTION=true
BILLING_TRIAL_DAYS=14
BILLING_DEFAULT_COUNTRY=US
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE=
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=1
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_RETRY_HOURS=24
YOOKASSA_GRACE_DAYS=7
PAYMENTS_WEBHOOK_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────────────
# Vite dev server origin allowed by the CSP in local env only
VITE_DEV_SERVER_URL=http://localhost:5173
# Send HSTS header (always on in production)
SECURITY_HSTS=false

VITE_APP_NAME="${APP_NAME}"

# Legal & privacy (PLATFORM.md section 10). Operator identity used by resources/legal/*.md placeholders.
LEGAL_REVIEWED=false
LEGAL_COMPANY_NAME="[Company name]"
LEGAL_COMPANY_REGISTRATION="[Registration number]"
LEGAL_COMPANY_ADDRESS="[Registered address]"
LEGAL_COMPANY_EMAIL=legal@example.com
LEGAL_PRIVACY_EMAIL=privacy@example.com
LEGAL_DPO="[Data protection officer]"
LEGAL_EU_REPRESENTATIVE="[EU representative or \"not appointed\"]"
LEGAL_GOVERNING_LAW="[Governing law]"
LEGAL_SUPPORT_HOURS="Mon-Fri, 09:00-18:00 UTC"
# AI sub-processors are listed from the providers the RAG API reports as configured (LEGAL_AI_DISCOVERY);
# LEGAL_LLM_PROVIDERS adds ids explicitly. Override entity data with LEGAL_AI_<ID>_NAME / LEGAL_AI_<ID>_ADDRESS.
LEGAL_AI_DISCOVERY=true
LEGAL_LLM_PROVIDERS=
LEGAL_HOSTING_ADDRESS="[Registered address]"
LEGAL_EMAIL_ADDRESS="[Registered address]"
LEGAL_TELEGRAM_ADDRESS="[Registered address]"
PRODUCT_SUPPORT_EMAIL=support@example.com
SECURITY_CONTACT=mailto:security@example.com
# Retention (days) and grace periods; workspaces may shorten/extend within limits.
RETENTION_AI_QUERIES_DAYS=180
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_DELIVERIES_DAYS=90
RETENTION_WEBHOOK_EVENTS_DAYS=30
PRIVACY_USER_DELETION_GRACE_DAYS=14
PRIVACY_WORKSPACE_DELETION_GRACE_DAYS=30
PRIVACY_EXPORT_LINK_HOURS=24
