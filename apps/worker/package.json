{
  "name": "@platform/worker",
  "private": true,
  "version": "0.1.0",
  "description": "Node service: BullMQ queues, outbox relay, email delivery, Telegram bot, webhook ingress and the RAG assistant API.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrateCli.ts",
    "migrate:prod": "node dist/db/migrateCli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup": "node scripts/setup-tessdata.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bull-board/api": "^9.10.5",
    "@bull-board/fastify": "^9.10.5",
    "bullmq": "^5.81.5",
    "domhandler": "^6.0.1",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "htmlparser2": "^12.0.0",
    "ioredis": "^5.11.1",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "nodemailer": "^10.2.1",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "stripe": "^23.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
