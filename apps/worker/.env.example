# ---------------------------------------------------------------------------
# Node service (Node 24 · BullMQ · grammY · Fastify · RAG assistant API)
# Copy to .env and adjust. Empty values (KEY=) mean "unset": the documented default applies.
# Without a .env the worker (outside production) falls back to this file, so a fresh clone
# runs fully offline: no Telegram/Stripe keys needed. Real process env always wins over files.
# ---------------------------------------------------------------------------

# Runtime: development | test | production. Production enforces 32+ char, distinct INTERNAL_KEY_* pair keys,
# a real STRIPE_WEBHOOK_SECRET, and disables /dev/* routes regardless of DEV_ROUTES.
NODE_ENV=development
# HTTP bind address/port (Fastify). Use 0.0.0.0 inside containers.
HOST=127.0.0.1
PORT=8101
# pino level: fatal|error|warn|info|debug|trace|silent. LOG_PRETTY=1 needs the pino-pretty dev dependency.
LOG_LEVEL=info
LOG_PRETTY=0

# Product identity (all user-facing bot/email strings use these; nothing is hard-coded).
PRODUCT_NAME="PayFlow Guard"
PRODUCT_SLUG=payflow

# Postgres (docker compose, pgvector image). The worker migrates only the `worker` schema.
DATABASE_URL=postgres://app:app@127.0.0.1:5441/payflow
DATABASE_POOL_MAX=10
# Redis 7 (docker compose). Never the native Redis 3 on 6379.
REDIS_URL=redis://127.0.0.1:6391
# BullMQ key prefix.
QUEUE_PREFIX=bull

# Process roles (ADR-0014): all | comma list of jobs, bot, ingress, rag. Development and E2E run `all` in one
# process on PORT (the web app reaches the RAG API at AI_URL=http://127.0.0.1:8101). Production runs two
# containers: `jobs,bot,ingress` (default there) and `rag` on 8102; `all` is refused in production.
WORKER_ROLES=all

# Service-to-service signing (PLATFORM.md §4.1). MUST be identical in the web and worker .env.
# Left empty here: `npm run setup` (scripts/env-sync.ts) writes one shared value into every app.
# Empty outside production = built-in development secret (with a warning); required (32+ chars) in production.
INTERNAL_API_SECRET=
# Per-pair keys (ADR-0010): web <-> worker, worker <-> rag and web <-> rag (the RAG API answers as service `ai`).
# Written by `npm run setup`; required (32+ chars, distinct) in production for the roles a process runs:
# jobs/bot/ingress need WEB_WORKER + WORKER_AI, rag needs WEB_AI + WORKER_AI. Empty outside production = INTERNAL_API_SECRET.
INTERNAL_KEY_WEB_WORKER=
INTERNAL_KEY_WORKER_AI=
INTERNAL_KEY_WEB_AI=
# Internal base URLs of the other services.
WEB_URL=http://127.0.0.1:8100
# RAG API used when this process does not run the `rag` role itself (production: http://rag:8102;
# with WORKER_ROLES=all the process serves it in-process on PORT).
AI_URL=http://127.0.0.1:8101
# Public URL of the web app used in links shown to users (defaults to WEB_URL).
WEB_PUBLIC_URL=http://127.0.0.1:8100
# Timeouts (ms) for web calls, RAG /v1/chat and RAG ingest/re-embed.
WEB_TIMEOUT_MS=10000
AI_CHAT_TIMEOUT_MS=90000
AI_INGEST_TIMEOUT_MS=600000
# Also post Telegram questions/answers to web POST /internal/v1/ai-queries. Off by default: the RAG API
# already logs every /v1/chat (all channels) with the same X-Request-Id, and web dedupes by it.
LOG_AI_QUERIES=0

# Transactional outbox relay (PLATFORM.md §4.2).
OUTBOX_ENABLED=1
OUTBOX_TABLE=public.outbox_messages
OUTBOX_CHANNEL=outbox
OUTBOX_POLL_MS=2000
OUTBOX_BATCH_SIZE=100
# Set to 0 to run only HTTP + relay (no BullMQ consumers), e.g. for a dedicated ingress replica.
WORKERS_ENABLED=1
# Daily privacy purge (due deletions + retention, PLATFORM.md section 10.2): cron in UTC; empty disables it.
PRIVACY_PURGE_CRON="15 3 * * *"
BILLING_RENEWALS_CRON="20 * * * *"
PAYMENTS_RECONCILE_CRON="*/30 * * * *"
WEBHOOK_TRUSTED_PROXY_HOPS=0

# Stripe: webhook signing secret (Stripe's whsec_… or the fake-billing secret shared with web).
# Empty = whsec_test_local (the fake-billing default, outside production only); setup syncs the same value into web.
# Production refuses to start without a real whsec_… secret.
STRIPE_WEBHOOK_SECRET=
# Optional; not needed for webhook verification.
STRIPE_SECRET_KEY=

# Telegram bot. Without a token the bot runs offline: outbound calls are captured
# (see GET /dev/telegram/outbox) and /dev/telegram/update still works.
# Mode: polling | webhook | disabled (without a token the mode is irrelevant: the bot is offline).
TELEGRAM_MODE=disabled
TELEGRAM_BOT_TOKEN=
# Username without @ (used for deep links); defaults to <PRODUCT_SLUG>_bot.
TELEGRAM_BOT_USERNAME=payflow_guard_bot
# Webhook mode: Telegram sends this in X-Telegram-Bot-Api-Secret-Token; URL is registered on start.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# Bot API root (change only for a self-hosted Bot API server).
TELEGRAM_API_ROOT=https://api.telegram.org
# Per-chat rate limit: BOT_RATE_LIMIT messages per BOT_RATE_WINDOW_S seconds.
BOT_RATE_LIMIT=20
BOT_RATE_WINDOW_S=60
# Lifetime of inline-button actions stored in Redis (seconds).
BOT_ACTION_TTL_S=86400
# Cache of the web telegram context per user (seconds; 0 disables).
BOT_ACCOUNT_CACHE_TTL_S=60

# SMTP (Mailpit in dev: UI on http://127.0.0.1:8131).
SMTP_HOST=127.0.0.1
SMTP_PORT=1031
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
# Defaults to "<PRODUCT_NAME>" <no-reply@<PRODUCT_SLUG>.test>.
MAIL_FROM=

# Dev/test routes (/dev/telegram/*). Ignored when NODE_ENV=production.
DEV_ROUTES=1
# Bull Board at /admin/queues (basic auth). The dashboard is disabled while the password is empty;
# `npm run setup` generates one.
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# RAG assistant API (role `rag`, PLATFORM.md section 4.4-4.6). Every value has an offline default:
# the mock provider and hash embeddings need no keys and no downloads.
# ---------------------------------------------------------------------------

# Key (or passphrase) that encrypts provider API keys saved from the admin UI (AES-256-GCM; keys saved earlier
# in the Fernet format are still read). Required (32+ chars) in production for the rag role;
# empty outside production = derived from INTERNAL_API_SECRET. Changing it invalidates saved keys.
AI_SETTINGS_KEY=
# Postgres schema owned by the RAG API (migrated on start).
RAG_SCHEMA=rag

# LLM defaults (the admin UI settings stored in rag.settings take precedence).
# mock | anthropic | openai | deepseek | openrouter | nvidia | opencode-zen | opencode-go | ollama
AI_PROVIDER=mock
# Empty = the provider's default model (anthropic: claude-opus-5-5, mock: mock-extractive-1).
AI_MODEL=
# Used on 404/403 and after 3 rate-limited attempts.
AI_FALLBACK_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
# 429 / transient retry backoff (ms); retry-after headers win.
AI_RETRY_BASE_MS=2000
AI_RETRY_MAX_MS=30000
AI_REQUEST_TIMEOUT_MS=90000
# Anthropic server-side refusal fallbacks on models that support them.
ANTHROPIC_SERVER_FALLBACKS=1

# Provider keys (optional; a key saved in the admin UI overrides these).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OpenCode Zen and Go share one key when only one is set.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
# Keyless local models.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Workspaces that do not allow external LLM providers (ai_external_allowed = false, PLATFORM.md section 10.2)
# are answered by this local model: mock (offline, extractive) or ollama (OLLAMA_BASE_URL).
LOCAL_LLM_PROVIDER=mock
# Requests that do not carry ai_external_allowed are treated as this value (0 = external providers off).
RAG_EXTERNAL_DEFAULT=0

# Embeddings: hash (deterministic, offline; dev and tests) | local (@huggingface/transformers when installed,
# falls back to hash) | openai-compatible (OpenAI / NVIDIA / Ollama /embeddings).
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_MODEL=
# openai-compatible only: endpoint, key (falls back to OPENAI_API_KEY) and vector size.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIMS=384
EMBEDDINGS_BATCH_SIZE=32
# Model cache for local embeddings (default ~/.cache/transformers-js).
EMBEDDINGS_CACHE_DIR=
# While a model is still loading, chat and search wait at most this long, then use hash embeddings.
EMBEDDINGS_LOAD_WAIT_MS=15000

# Retrieval and answers: refusal below this fused confidence (0..1), sources per answer, RRF candidates.
RAG_MIN_CONFIDENCE=0.35
RAG_TOP_K=6
RAG_CANDIDATES=40
RAG_RRF_K=60
# Chunk size (~tokens) and overlap ratio.
RAG_CHUNK_TOKENS=700
RAG_CHUNK_OVERLAP=0.15
# Conversation memory: last N turns per conversation_id (kept at most 30 days).
RAG_MEMORY_TURNS=6
# Comma-separated roles that see role-restricted documents (empty = strict role match).
RAG_PRIVILEGED_ROLES=
# Largest document the RAG API downloads (MB) and agent tool rounds per question.
RAG_MAX_FILE_MB=50
AGENT_MAX_ITERATIONS=4

# Untrusted uploads are parsed in a child process without keys or database access (ADR-0014).
RAG_PARSE_ISOLATION=1
RAG_PARSE_TIMEOUT_MS=300000
RAG_PARSE_MAX_MEMORY_MB=256

# OCR (Tesseract CLI). Missing language packs degrade with a warning; `npm run setup` in this app downloads
# eng/rus/osd into .tessdata/ (set TESSDATA_PREFIX to it when the system install lacks Russian).
OCR_LANGUAGES=rus+eng
TESSERACT_CMD=tesseract
TESSDATA_PREFIX=
# Per page.
OCR_TIMEOUT_MS=120000
OCR_MAX_PAGES=300
