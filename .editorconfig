root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[*.{ts,mts,cts,js,mjs,cjs,vue}]
indent_size = 4

[{apps/worker,e2e,scripts}/**.{ts,js,mjs,json}]
indent_size = 2

[*.py]
indent_size = 4

[*.{ps1,psm1,cmd,bat}]
end_of_line = crlf

[{Dockerfile,*.Dockerfile,Dockerfile.*}]
indent_size = 4

[Makefile]
indent_style = tab

[docker-compose*.yml]
indent_size = 2
